# Define R/W patterns
# Groups: rand (random access), seq (sequential access)
# Patterns: ReadOnly, ReadH (rwmixwrite=20), ReadB (rwmixread=50), WriteH (rwmixwrite=80), WriteOnly
#
# Usage: fio <this-script>.fio --section=<sec-name>
# Or run all sections: fio <this-script>.fio

[global]
runtime=60
time_based=1
direct=1
buffered=0
group_reporting=1
randrepeat=0
norandommap=1
refill_buffers=1
# size=128m yields a 2 GiB total working set (16 jobs x 128 MiB), which fio's
# time_based=1 loop revisits hundreds of times within 60 s at high bandwidth,
# producing read throughput that mostly reflects re-access to recently
# overwritten data rather than steady-state storage performance. size=20g
# (320 GiB total across 16 jobs) keeps the 60-s read window to roughly one
# pass even at peak observed bandwidth (~5.4 GiB/s aggregate).
size=20g
filename_format=fio_data.$jobnum.$filenum

# ── Prefill: sequential write to guarantee all blocks exist before any read ── #
[prefill]
rw=write
time_based=0
stonewall

# ── Random Access ── #
# Write-first
[rand_write]
rw=randwrite
stonewall

[rand_read]
rw=randread
stonewall

[rand_readH]
rw=randrw
rwmixwrite=20
unified_rw_reporting=1
stonewall

[rand_readB]
rw=randrw
rwmixread=50
unified_rw_reporting=1
stonewall

[rand_writeH]
rw=randrw
rwmixwrite=80
unified_rw_reporting=1
stonewall



# ── Sequential Access ── #
[seq_write]
rw=write
stonewall

[seq_read]
rw=read
stonewall

[seq_readH]
rw=readwrite
rwmixwrite=20
unified_rw_reporting=1
stonewall

[seq_readB]
rw=readwrite
rwmixread=50
unified_rw_reporting=1
stonewall

[seq_writeH]
rw=readwrite
rwmixwrite=80
unified_rw_reporting=1
stonewall
