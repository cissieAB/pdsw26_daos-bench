#!/bin/bash

# Usage example: qsub -l select=<N>:ncpus=208 -v PPN=48,NITER=2,TX_SIZE=16M,DISABLE_PAGE_CACHE=1 <this-script>.qsub
# N is set via -l select=N; PPN defaults to 48, ITER defaults to 2, TX_SIZE defaults to 16M
# DISABLE_PAGE_CACHE defaults to 0 (page cache allowed); set to 1 to bypass the Linux page cache via O_DIRECT (IOR -B)

#PBS -l walltime=00:59:00
#PBS -A e2sar-daos
#PBS -q debug-scaling
#PBS -l filesystems=home:flare:daos_user_fs
#PBS -j oe

# Load DAOS module
module use /soft/modulefiles/ || { echo "Failed to use modulefiles"; exit 1; }
module load daos || { echo "Failed to load DAOS module"; exit 1; }

# Variables
POOL_NAME=e2sar
PPN=${PPN:-48}
NITER=${NITER:-2}
TX_SIZE=${TX_SIZE:-16M}
DISABLE_PAGE_CACHE=${DISABLE_PAGE_CACHE:-0}

NNODES=$(wc -l < $PBS_NODEFILE)
HOSTNAMES=$(cat $PBS_NODEFILE | tr '\n' ',')
echo "Nodes (${NNODES}): ${HOSTNAMES}"
echo "PPN: ${PPN}, NITER: ${NITER}, TX_SIZE: ${TX_SIZE}, DISABLE_PAGE_CACHE: ${DISABLE_PAGE_CACHE}"

# When enabled, bypass the Linux page cache with O_DIRECT and tag the LOG label accordingly
IOR_CACHE_FLAG=""
CACHE_LABEL="cached"
if [ "${DISABLE_PAGE_CACHE}" = "1" ]; then
    IOR_CACHE_FLAG="-B"
    CACHE_LABEL="nocache"
fi

START_TIME=$SECONDS

# Verify pool exists
daos pool list | grep -q -- "$POOL_NAME" || { echo "No pool: $POOL_NAME"; exit 1; }


# Compute node default path is $HOME
WKDIR=$HOME/iobench/pdsw26_daos-bench/scripts/aurora/ior/ior-rw-scaling   # <=== Change dir as needed
cd "${WKDIR}"


# skip-1 breadth scan. Bind 48 cores
CPU_BINDING_SKIP1="list:4:6:56:58:9:11:61:63:12:14:64:66:17:19:69:71:20:22:72:74:25:27:77:79:28:30:80:82:33:35:85:87:36:38:88:90:41:43:93:95:44:46:96:98:49:51:100:102"
export ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE
export AFFINITY_ORDERING=compact

# Add ior into path
export PATH=$PATH:$HOME/ior/install/bin

RANKS_PER_NODE=${PPN}
NRANKS=$(( NNODES * RANKS_PER_NODE ))

echo "Running IOR write test"
# IOR parameters
# -i: Repeat the test this many times
# -o: the absolute path in the DFS container. Imagine the DFS root is /.
# --dfs.destroy: destroy the DAOS container after the test
# -b: ior block size, contiguous bytes to write per task
# -t: ior transfer size, size of transfer in bytes
# -s: number of segments. Not applied here.

# Create container with RD factor 1 (default is 3)
CONTAINER_NAME="${USER}-ior_n${NNODES}"
# Check if container exists
if daos cont query "$POOL_NAME" "$CONTAINER_NAME" >/dev/null 2>&1; then
    echo "Container $CONTAINER_NAME already exists, destroying it..."
    if ! daos container destroy "$POOL_NAME" "$CONTAINER_NAME"; then
        echo "Failed to destroy container $CONTAINER_NAME"
        exit 1
    fi
else
    echo "Container $CONTAINER_NAME does not exist, will create a new one."
fi
# Create container
if ! daos container create --type=POSIX "$POOL_NAME" "$CONTAINER_NAME" --properties=rd_fac:0; then
    echo "Failed to create container $CONTAINER_NAME"
    exit 1
fi
echo "Get container properties:"
daos container get-prop $POOL_NAME $CONTAINER_NAME


# IOR smoke test
LD_PRELOAD=/usr/lib64/libpil4dfs.so mpiexec -np ${NRANKS} -ppn ${RANKS_PER_NODE} --cpu-bind ${CPU_BINDING_SKIP1}  \
                                            --no-vni -genvall -- \
                                            ior -a DFS -w -r ${IOR_CACHE_FLAG} \
                                            --dfs.pool $POOL_NAME --dfs.cont $CONTAINER_NAME --dfs.chunk_size=2m \
                                            -o /ior-smoke \
                                            -b 64M -t 16M


RESULTS_DIR="../../../results/aurora/ior/ior-rw"
mkdir -p $RESULTS_DIR

NSEGMENTS=32

echo -e "\nRunning IOR read-write with transfer size: $TX_SIZE, RANKS_PER_NODE: ${RANKS_PER_NODE}, total ranks: $NRANKS, cache: ${CACHE_LABEL}"
LD_PRELOAD=/usr/lib64/libpil4dfs.so mpiexec -np ${NRANKS} -ppn ${RANKS_PER_NODE} --cpu-bind ${CPU_BINDING_SKIP1}  \
                                            --no-vni -genvall -- \
                                            ior -a DFS -w -r ${IOR_CACHE_FLAG} \
                                            --dfs.pool $POOL_NAME --dfs.cont $CONTAINER_NAME --dfs.chunk_size=2m \
                                            -o /ior-rw-tx_${TX_SIZE}-ppn_${RANKS_PER_NODE} \
                                            -s ${NSEGMENTS} -b 128M -t ${TX_SIZE} -i ${NITER} \
                                            -O summaryFile=${RESULTS_DIR}/ior_rw_n-${NNODES}_ppn-${RANKS_PER_NODE}_tx-${TX_SIZE}_${CACHE_LABEL}_$(date +%s).csv -O summaryFormat=CSV


# Destroy container
daos cont destroy $POOL_NAME $CONTAINER_NAME || echo "Failed to destroy container $CONTAINER_NAME"

ELAPSED_TIME=$((SECONDS - START_TIME))
echo "Completed script in $ELAPSED_TIME seconds"
