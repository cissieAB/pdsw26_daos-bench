# fio write benchmark: DAOS POSIX container, native DFS engine.
;
;
;
; Example - 
;   $HOME/local/bin/fio \
;         --ioengine=dfs --chunk_size=2m --pool=e2sar --cont=${CONT} \
;         --section=write-large_fs-16g \
;         --output-format=json --output=fio-$(datetime +s%).json \
;         <this-file>.fio'
;
; Use --section=write-large_fs-16g for Sc.2. Without --section, each fio
; process runs both sections; the stonewall makes Sc.2 wait until Sc.1
; finishes within that process (ranks are NOT synchronized with each other).

[global]
rw=randwrite
iodepth=16
create_on_open=1
group_reporting=1

; --- Sc.1-style: many small files (1 TiB = 2,621,44 x 4 MiB) ---
[write-small_fs-4m]
bs=2m
numjobs=64
size=16g                ; per job; fio divides by nrfiles -> 4 MiB/file
nrfiles=4096
file_service_type=sequential
filename_format=small.$jobnum.$filenum


; --- Sc.2-style: few large files (1 TiB = 64 x 16 GiB) ---
[write-large_fs-16g]
stonewall
bs=2m
filesize=16g
numjobs=64
filename_format=large.$jobnum
