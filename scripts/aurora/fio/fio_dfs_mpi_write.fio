; MPI-launched fio write benchmark: DAOS POSIX container, native DFS engine.
;
; fio is not MPI-aware, so mpiexec starts one *independent* fio process per
; rank. Each rank owns a disjoint file set: filename_format embeds ${RANKID},
; which fio expands from the environment, so ranks never touch each other's
; files. RANKID must be set per rank (on Aurora/PALS use PALS_RANKID).
;
; Sizing assumes 32 total ranks; each rank writes 320 GiB -> ~10 TiB/section:
;   Sc.1 small files: 16 jobs x 5120 files x 4 MiB  (2,621,440 files total)
;   Sc.2 large files:  4 jobs x    5 files x 16 GiB (640 files total)
;
; Required environment (fio expands ${VAR} in this file from the environment):
;   DAOS_POOL  pool label
;   DAOS_CONT  POSIX container label
;   RANKID     per-rank id used in filename_format
;
; Example - run ONLY the small-file section on 2 nodes x 16 ranks/node
; (inside a PBS job, with the daos module loaded and DAOS_POOL/DAOS_CONT
; exported):
;
;   mpiexec -np 32 --ppn 16 --genvall bash -c '
;     export RANKID=${PALS_RANKID:-0}
;     exec fio --section=write-small_fs-4m \
;         --output-format=json --output=fio_rank${RANKID}.json \
;         fio_dfs_mpi_write.fio'
;
; Use --section=write-large_fs-16g for Sc.2. Without --section, each fio
; process runs both sections; the stonewall makes Sc.2 wait until Sc.1
; finishes within that process (ranks are NOT synchronized with each other).

[global]
rw=write
iodepth=16
thread=1
create_on_open=1
group_reporting=1
end_fsync=1

; --- Sc.1-style: many small files (10 TiB = 2,621,440 x 4 MiB) ---
[write-small_fs-4m]
bs=1m
filesize=4m
numjobs=16
nrfiles=5120
openfiles=128
file_service_type=sequential
filename_format=small.rank${RANKID}.$jobnum.$filenum


; --- Sc.2-style: few large files (10 TiB = 640 x 16 GiB) ---
[write-large_fs-16g]
stonewall
bs=1m
filesize=16g
numjobs=32
nrfiles=20
openfiles=8
filename_format=large.rank${RANKID}.$jobnum.$filenum
